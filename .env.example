# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Backend API base URL — no trailing slash
VITE_API_URL=http://localhost:8080

# Public site URL used for canonical / Open Graph (optional)
VITE_APP_URL=http://localhost:5173

# Stripe Checkout is configured on the backend (STRIPE_*).
# Frontend only redirects to the Checkout URL returned by POST /api/payments/create-checkout-session.